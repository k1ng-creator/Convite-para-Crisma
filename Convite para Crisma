<!doctype html>
<html lang="pt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crisma de Klismen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@400;500&display=swap">
<style>
/* Layout: convite em faixas verticais. Abre com um arco de janela de igreja a emoldurar a foto de Nossa Senhora de Fátima, depois texto, dons, detalhes, foto, e dois formulários que preparam mensagens de WhatsApp. */
:root {
  --ink: #101d3b;
  --ink-soft: #2b3a5e;
  --sky: #dce8f4;
  --paper: #f5f8fc;
  --white: #ffffff;
  --gold: #8a6419;
  --gold-bright: #d2ad55;
  --wine: #8a1c2b;
  --line: #c9d5e4;
  --font-display: "Cinzel", "Trajan Pro", Georgia, "Times New Roman", serif;
  --font-body: "Cormorant Garamond", Georgia, "Times New Roman", serif;
  --font-ui: "Jost", "Helvetica Neue", Arial, sans-serif;
  color-scheme: light;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 1.25rem;
  line-height: 1.55;
  margin: 0;
}
h1, h2, h3 { margin: 0; font-weight: 600; text-wrap: balance; }
p { margin: 0; }
.wrap {
  max-width: 44rem;
  margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.eyebrow {
  font-family: var(--font-ui);
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}
.rule {
  display: flex; align-items: center; justify-content: center; gap: 0.9rem;
  color: var(--gold-bright);
}
.rule::before, .rule::after { content: ""; height: 1px; width: min(18vw, 5rem); background: currentColor; opacity: 0.7; }
.rule svg { width: 1.1rem; height: 1.1rem; }

/* Faixa de abertura */
.hero { background: var(--ink); color: var(--white); text-align: center; position: relative; overflow: hidden; }
.hero::before {
  content: ""; position: absolute; inset: -20% -10% auto -10%; height: 70%;
  background: radial-gradient(60% 60% at 50% 30%, rgba(210,173,85,0.28), rgba(210,173,85,0) 70%);
  pointer-events: none;
}
.hero .wrap { position: relative; padding-block: 2.6rem 3.4rem; display: grid; gap: 1.4rem; justify-items: center; }
.hero .eyebrow { color: var(--gold-bright); }
.arch {
  width: min(78vw, 21rem);
  aspect-ratio: 3 / 4;
  border-radius: 999px 999px 0.4rem 0.4rem;
  overflow: hidden;
  border: 2px solid var(--gold-bright);
  box-shadow: 0 0 0 0.5rem var(--ink), 0 0 0 calc(0.5rem + 1px) var(--gold-bright);
  margin-block: 0.6rem 0.8rem;
  animation: rise 1.1s ease-out both;
}
.arch img { width: 100%; height: 100%; object-fit: cover; display: block; }
.hero h1 {
  font-family: var(--font-display);
  letter-spacing: 0.12em;
  line-height: 1.1;
  display: grid; gap: 0.35rem;
}
.hero h1 .first { font-size: clamp(2.3rem, 11vw, 4rem); font-weight: 700; color: var(--white); }
.hero h1 .last { font-size: clamp(1.05rem, 5vw, 1.7rem); font-weight: 400; color: var(--gold-bright); letter-spacing: 0.2em; }
.hero .lead { max-width: 28rem; font-size: 1.35rem; font-style: italic; color: #dbe5f3; }
.hero .when { font-family: var(--font-display); letter-spacing: 0.1em; font-size: 1.05rem; }
.count {
  font-family: var(--font-ui); font-size: 0.85rem; letter-spacing: 0.08em;
  color: var(--ink); background: var(--gold-bright);
  padding: 0.35rem 0.9rem; border-radius: 99px;
}
@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

/* Palavras e versículos */
.band { padding-block: 3.2rem; }
.band.alt { background: var(--sky); }
.center { text-align: center; }
.stack { display: grid; gap: 1.2rem; }
h2.title {
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 5.4vw, 1.9rem);
  letter-spacing: 0.08em;
  color: var(--ink);
}
.words p { font-size: 1.3rem; }
.verse { display: grid; gap: 0.6rem; justify-items: center; }
.verse blockquote {
  margin: 0; font-style: italic; font-weight: 500;
  font-size: clamp(1.4rem, 5.6vw, 1.85rem); line-height: 1.4; max-width: 34rem; text-wrap: balance;
}
.verse cite { font-family: var(--font-ui); font-style: normal; font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
.verse.on-dark cite { color: var(--gold-bright); }

/* Sete dons */
.gifts { list-style: none; margin: 0.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 1.4rem 0.8rem; }
.gifts li { width: 8.2rem; display: grid; justify-items: center; gap: 0.35rem; font-family: var(--font-display); font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase; }
.gifts svg { width: 1.7rem; height: 2.1rem; color: var(--wine); }
.ref { font-family: var(--font-ui); font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }

/* Detalhes */
.details { display: grid; gap: 1.8rem; justify-items: center; }
.seal {
  width: 7.4rem; height: 7.4rem; border-radius: 50%;
  background: var(--wine); color: var(--white);
  display: grid; place-content: center; text-align: center; gap: 0.1rem;
  box-shadow: 0 0 0 0.3rem var(--paper), 0 0 0 calc(0.3rem + 1px) var(--wine);
  font-family: var(--font-display);
}
.seal .dow { font-size: 0.75rem; letter-spacing: 0.25em; }
.seal .day { font-size: 2.9rem; font-weight: 700; line-height: 1; }
.seal .mon { font-size: 0.75rem; letter-spacing: 0.2em; }
dl.facts { margin: 0; width: 100%; max-width: 32rem; border-top: 1px solid var(--line); }
dl.facts > div { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); align-items: baseline; }
dl.facts dt { font-family: var(--font-ui); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
dl.facts dd { margin: 0; font-size: 1.3rem; line-height: 1.35; }
dl.facts dd b { font-family: var(--font-display); font-weight: 600; letter-spacing: 0.04em; font-size: 1.1rem; }

/* Foto */
.photo { display: grid; gap: 1rem; justify-items: center; }
.frame { width: min(86vw, 24rem); position: relative; padding: 0.7rem; background: var(--white); border: 1px solid var(--line); box-shadow: 0.7rem 0.7rem 0 var(--gold-bright); }
.frame img { width: 100%; display: block; aspect-ratio: 3 / 4; object-fit: cover; }
.photo figcaption { font-style: italic; font-size: 1.15rem; color: var(--ink-soft); }

/* Formulários */
.card { background: var(--white); border: 1px solid var(--line); padding: 1.6rem 1.3rem; display: grid; gap: 1.1rem; text-align: left; }
.card h2 { text-align: center; }
.card .hint { text-align: center; font-size: 1.12rem; color: var(--ink-soft); }
.forms { display: grid; gap: 1.6rem; }
.field { display: grid; gap: 0.4rem; min-width: 0; }
.field label, .field legend { font-family: var(--font-ui); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); padding: 0; }
fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
input[type="text"], select, textarea {
  width: 100%; font: 400 1.05rem/1.4 var(--font-ui); color: var(--ink); background: var(--paper);
  border: 1px solid #9fb2cb; border-radius: 2px; padding: 0.75rem 0.8rem;
}
textarea { min-height: 7rem; resize: vertical; }
input:focus-visible, select:focus-visible, textarea:focus-visible, .btn:focus-visible, .choice input:focus-visible + span {
  outline: 3px solid var(--gold-bright); outline-offset: 2px;
}
.choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.6rem; }
.choice { position: relative; display: block; }
.choice input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.choice span {
  display: block; padding: 0.8rem 0.9rem; text-align: center; font: 500 0.98rem/1.3 var(--font-ui);
  border: 1px solid #9fb2cb; background: var(--paper); color: var(--ink);
}
.choice input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--white); }
.actions { display: grid; gap: 0.7rem; }
.btn {
  display: block; text-align: center; text-decoration: none; cursor: pointer;
  font: 500 0.92rem/1.2 var(--font-ui); letter-spacing: 0.14em; text-transform: uppercase;
  padding: 1rem 1.2rem; border: 1px solid var(--ink); background: var(--ink); color: var(--white);
}
.btn.ghost { background: transparent; color: var(--ink); }
.btn[aria-disabled="true"] { background: #7d8aa5; border-color: #7d8aa5; cursor: not-allowed; }
.status { min-height: 1.4rem; font-family: var(--font-ui); font-size: 0.92rem; color: var(--wine); text-align: center; }
.status.ok { color: var(--ink-soft); }
.note { font-family: var(--font-ui); font-size: 0.82rem; line-height: 1.5; color: var(--ink-soft); text-align: center; }

/* Rodapé */
.foot { background: var(--ink); color: #dbe5f3; text-align: center; padding-block: 3rem 3.4rem; }
.foot .wrap { display: grid; gap: 1.2rem; justify-items: center; }
.foot .sign { font-family: var(--font-display); letter-spacing: 0.14em; font-size: 1.05rem; color: var(--white); }
.foot small { font-family: var(--font-ui); font-size: 0.8rem; letter-spacing: 0.1em; }

@media (max-width: 30rem) {
  body { font-size: 1.18rem; }
  dl.facts > div { grid-template-columns: 1fr; gap: 0.2rem; }
}
@media (prefers-reduced-motion: reduce) {
  .arch { animation: none; }
  html { scroll-behavior: auto; }
}
</style>
<style>[hidden]{display:none!important} img{max-width:100%}</style>
</head>
